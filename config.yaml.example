# Configuracao do X9
# Ajuste os valores abaixo antes de rodar o programa.

camera:
  index: 0
  width: 640
  height: 480
  fps: 3
  open_retries: 3
  open_retry_delay_seconds: 2.0

detector:
  input_size: 416
  confidence: 0.60
  nms_threshold: 0.45
  positive_frames: 5
  window_seconds: 3

notification:
  cooldown_seconds: 600
  title: "X9"
  message: "Presenca detectada no computador"
  # ATENCAO: a URL abaixo e um segredo. No ntfy.sh publico nao existe
  # autenticacao: quem souber o nome do topico le todos os seus alertas
  # e pode publicar alertas falsos. Use um nome longo e aleatorio, nunca
  # algo adivinhavel, e nunca faca commit deste arquivo preenchido
  # (config.yaml esta no .gitignore de proposito).
  #
  # URLs no formato aceito pelo Apprise. Exemplos:
  #   ntfy self hosted ou publico:  ntfy://ntfy.sh/SEU_TOPICO_SECRETO
  #   Telegram:                     tgram://TOKEN_DO_BOT/CHAT_ID
  #   Gotify:                       gotify://SEU_SERVIDOR/TOKEN
  #   Discord:                      discord://WEBHOOK_ID/WEBHOOK_TOKEN
  # Pode colocar mais de uma URL para receber em varios canais ao mesmo tempo.
  urls:
    - "ntfy://ntfy.sh/TROQUE_ESTE_TOPICO"

logging:
  level: INFO
